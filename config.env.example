# Food Calendar — Environment Configuration
# Copy this file to .env and fill in your values.
# .env is already in .gitignore and will never be committed.

# ---------------------------------------------------------------------------
# USERS
# ---------------------------------------------------------------------------
# JSON array of household members. Each user needs:
#   id          — unique key used in the database (no spaces)
#   display_name — name shown in the UI
#   color        — hex colour for the name badge (light tints work best)
#   sort_order   — display order in the UI (0, 1, 2, ...)
#
# Example (replace with your household):
FOOD_USERS='[
  {"id":"alice","display_name":"Alice","color":"#c6f6d5","sort_order":0},
  {"id":"bob","display_name":"Bob","color":"#feebc8","sort_order":1},
  {"id":"charlie","display_name":"Charlie","color":"#bee3f8","sort_order":2}
]'

# ---------------------------------------------------------------------------
# DATABASE
# ---------------------------------------------------------------------------
# Path to the SQLite database file.
# Defaults to food-calendar.db in the project root.
# FOOD_CALENDAR_DB=/full/path/to/food-calendar.db

# ---------------------------------------------------------------------------
# SERVER
# ---------------------------------------------------------------------------
# Port for the HTTP server (default: 3300)
# PORT=3300
